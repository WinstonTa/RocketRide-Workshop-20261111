{
  "name": "Excalidraw diagram agent",
  "source": "webhook_1",
  "project_id": "dafb1567-0f6e-4b87-a00e-74ce8bef1db7",
  "version": 1,
  "components": [
    {
      "id": "webhook_1",
      "provider": "webhook",
      "config": {
        "hideForm": true,
        "mode": "Source",
        "parameters": {},
        "type": "webhook"
      },
      "input": []
    },
    {
      "id": "question_1",
      "provider": "question",
      "config": {},
      "input": [
        {
          "lane": "text",
          "from": "webhook_1"
        }
      ]
    },
    {
      "id": "agent_rocketride_1",
      "provider": "agent_rocketride",
      "config": {
        "instructions": [
          "Turn the user's request into one Mermaid diagram that Excalidraw will draw.",
          "If the request names a public GitHub repository as owner/repo or a github.com link, first GET https://raw.githubusercontent.com/OWNER/REPO/HEAD/README.md with the github.http_request tool.",
          "Read at most three more files linked from the README and draw only what you read.",
          "Otherwise, draw the diagram from the request.",
          "Use flowchart LR or flowchart TD unless the user asks for a sequence diagram.",
          "Use fewer than 20 nodes and short labels; do not use quotes, parentheses, or brackets inside labels.",
          "If the conversation already has a diagram and the user requests a change, return the whole updated diagram.",
          "Reply with only Mermaid code, without explanation or code fences."
        ],
        "max_waves": 6,
        "parameters": {}
      },
      "input": [
        {
          "lane": "questions",
          "from": "question_1"
        }
      ]
    },
    {
      "id": "llm_anthropic_1",
      "provider": "llm_anthropic",
      "config": {
        "profile": "claude-sonnet-4-6",
        "claude-sonnet-4-6": {
          "apikey": "${ROCKETRIDE_ANTHROPIC_KEY}"
        },
        "parameters": {}
      },
      "control": [
        {
          "classType": "llm",
          "from": "agent_rocketride_1"
        }
      ]
    },
    {
      "id": "memory_internal_1",
      "provider": "memory_internal",
      "config": {
        "type": "memory_internal"
      },
      "control": [
        {
          "classType": "memory",
          "from": "agent_rocketride_1"
        }
      ]
    },
    {
      "id": "tool_http_request_1",
      "provider": "tool_http_request",
      "config": {
        "type": "tool_http_request",
        "serverName": "github",
        "allowPOST": false,
        "allowPUT": false,
        "allowPATCH": false,
        "allowDELETE": false,
        "urlWhitelist": [
          {
            "whitelistPattern": "^https://raw[.]githubusercontent[.]com/"
          }
        ]
      },
      "control": [
        {
          "classType": "tool",
          "from": "agent_rocketride_1"
        }
      ]
    },
    {
      "id": "response_answers_1",
      "provider": "response_answers",
      "config": {
        "laneName": "answers"
      },
      "input": [
        {
          "lane": "answers",
          "from": "agent_rocketride_1"
        }
      ]
    }
  ]
}
